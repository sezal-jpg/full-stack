import React from 'react';
import './ProductCard.css';

/**
 * ProductCard Component
 * 
 * A reusable product card component that displays product information
 * with dynamic data through props and visual stock status indicators.
 * 
 * Props:
 * @param {string} image - URL of the product image
 * @param {string} name - Name of the product
 * @param {string} description - Brief description of the product
 * @param {number} price - Product price
 * @param {string} currency - Currency symbol (default: '$')
 * @param {number} stock - Available stock quantity
 * @param {string} category - Product category
 * @param {number} rating - Product rating (0-5)
 * @param {function} onAddToCart - Callback function when Add to Cart is clicked
 */

const ProductCard = ({
  image,
  name,
  description,
  price,
  currency = '$',
  stock,
  category,
  rating = 0,
  onAddToCart
}) => {
  // Determine stock status
  const getStockStatus = () => {
    if (stock === 0) return { text: 'Out of Stock', class: 'out-of-stock' };
    if (stock < 5) return { text: 'Low Stock', class: 'low-stock' };
    return { text: 'In Stock', class: 'in-stock' };
  };

  const stockStatus = getStockStatus();

  // Render star rating
  const renderStars = () => {
    return (
      <div className="rating">
        {[...Array(5)].map((_, index) => (
          <span
            key={index}
            className={`star ${index < rating ? 'filled' : ''}`}
          >
            ★
          </span>
        ))}
        <span className="rating-value">({rating.toFixed(1)})</span>
      </div>
    );
  };

  return (
    <div className="product-card">
      {/* Product Image */}
      <div className="product-image-container">
        <img src={image} alt={name} className="product-image" />
        {category && <span className="category-badge">{category}</span>}
        <span className={`stock-badge ${stockStatus.class}`}>
          {stockStatus.text}
        </span>
      </div>

      {/* Product Details */}
      <div className="product-details">
        <h3 className="product-name">{name}</h3>
        <p className="product-description">{description}</p>

        {/* Rating */}
        {renderStars()}

        {/* Price and Stock Info */}
        <div className="product-footer">
          <div className="price-section">
            <span className="price">
              {currency}{price.toFixed(2)}
            </span>
            <span className="stock-count">
              {stock > 0 ? `${stock} available` : 'Unavailable'}
            </span>
          </div>

          {/* Add to Cart Button */}
          <button
            className="add-to-cart-btn"
            onClick={onAddToCart}
            disabled={stock === 0}
          >
            {stock === 0 ? 'Sold Out' : 'Add to Cart'}
          </button>
        </div>
      </div>
    </div>
  );
};

export default ProductCard;
